# HANDOFF ONLY. Leave blank until approved. No default credentials.
# Do not store a populated copy in this repo (.env is NOT gitignored here).
# Compose --env-file is for these nonsecret host paths/settings, not secret values.
OPS_BRAIN_START_APPROVED=false
OPS_BRAIN_IMAGE=ops-brain:handoff
PHX_HOST=
# Image-only HTTP_BIND accepts 127.0.0.1 (default) or 0.0.0.0.
# Compose fixes loopback; do not use wildcard with host networking.
RUNTIME_DATABASE_URL_FILE=
SECRET_KEY_BASE_FILE=
DATABASE_CA_HOST_FILE=
SOURCE_CONFIG_HOST_FILE=
# Migration one-off only; NEVER mount into app service.
MIGRATION_DATABASE_URL_FILE=
# Optional OIDC: concurrent auth slice consumes these names. NOT passed by Compose.
# Enable only in a separately reviewed override with authentication-owner approval.
OPS_BRAIN_OIDC_ENABLED=false
OPS_BRAIN_OIDC_REVIEWED=false
# OPS_BRAIN_OIDC_ISSUER=
# OPS_BRAIN_OIDC_AUTHORIZATION_ENDPOINT=
# OPS_BRAIN_OIDC_TOKEN_ENDPOINT=
# OPS_BRAIN_OIDC_JWKS_URI=
# OPS_BRAIN_OIDC_REDIRECT_URI=
# OPS_BRAIN_OIDC_CLIENT_ID=
# OPS_BRAIN_OIDC_AUTH_METHOD=
# OPS_BRAIN_OIDC_CLIENT_SECRET=
# OPS_BRAIN_OIDC_SUBJECTS=
# Scope is currently fixed to openid in code; no SCOPES setting is supported.
